# JackBus: a JACK server (JACK2 1.9.22 compatible) with RT / correctness / performance fixes
# and sound card bridges (https://github.com/nine7nine/JackBus, see the commit log). Formerly
# packaged as jack2dbus-nspa. One package
# replacing Arch's jack2 and jack2-dbus (same files, same paths, same configure
# options; no docs, no lib32). Client API/ABI, shared memory layout and protocol
# are unchanged: applications linked against jack2 keep working, and Arch's
# lib32-jack2 1.9.22 still works against this server.
#
# Also JackBus's shims: jackbus-pw (PipeWire applications), jackbus-pa
# (PulseAudio applications; /usr/lib/jackbus-pa on the session's library
# path sends them to JackBus while it runs, to PipeWire while it doesn't) and
# jackbus-alsa (the "jackbus" ALSA device). Nothing changes for an
# application until it is run through them or PatchBox's Shims switches are on.
#
# Builds the main branch from GitHub. To build from a local clone instead:
#   NSPA_REPO=/path/to/jack2 [NSPA_BRANCH=nspa] makepkg

pkgname=jackbus
pkgver=1.9.22.r190.g71f24328
pkgrel=1
pkgdesc="Real-time JACK audio server for Linux: a drop-in JACK2 with Modern Features & Improvements."
arch=(x86_64)
url="https://github.com/nine7nine/JackBus"
license=(GPL-2.0-or-later LGPL-2.1-or-later)
depends=(
  alsa-lib libasound.so
  db5.3
  dbus libdbus-1.so
  expat libexpat.so
  glibc
  libgcc
  libpulse
  libsamplerate libsamplerate.so
  libstdc++
  opus libopus.so

  systemd-libs libsystemd.so
)
makedepends=(alsa-lib db5.3 dbus expat git libffado libpipewire libpulse libsamplerate opus python systemd)
optdepends=(
  'a2jmidid: for ALSA MIDI to JACK MIDI bridging'
  'libffado: for firewire support using FFADO'
  'jack-example-tools: for official JACK example-clients and tools'
  'realtime-privileges: for realtime privileges'
  'python-dbus: for jack_control'
)
# jack2 1.9.22 provides; the version keeps dependents such as lib32-jack2
# (depends on jack2=1.9.22) installable
provides=(jack jack2=1.9.22 jack2-dbus=1.9.22 libjack.so libjacknet.so libjackserver.so)
conflicts=(jack jack2 jack2-dbus jack2dbus-nspa)
replaces=(jack2dbus-nspa)
# LTO on (makepkg's default LTOFLAGS=-flto=auto). Arch builds jack2 with !lto
# because of upstream #485, whose cause the fork fixed (C1, shm index/ownership);
# the LTO build passes the whole test suite. Measured in the engine against the
# same commit without LTO (16 clients, 32 frames, 12 interleaved runs): critical
# path median 214.8 vs 224.0 us, p99 438.7 vs 444.0 us, DSP load 16.6 vs 17.9%;
# server instructions per cycle -1..-5%.
if [[ -n ${NSPA_REPO:-} ]]; then
  source=("jack2::git+file://$NSPA_REPO#branch=${NSPA_BRANCH:-nspa}")
else
  source=("jack2::git+$url.git#branch=main")
fi
sha512sums=('SKIP')

pkgver() {
  cd jack2
  git describe --long --tags --match 'v1.9.22' | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g'
}

build() {
  local waf_options=(
    --prefix=/usr
    --htmldir=/usr/share/doc/jack2/html
    --autostart=none
    --doxygen=no
    --systemd-unit
    --classic
    --dbus
  )

  cd jack2
  # wscript prefers Berkeley DB 5.3 (/usr/include/db5.3, libdb-5.3) like
  # Arch's jack2: the metadata DB in /dev/shm is shared with every client
  python3 ./waf configure "${waf_options[@]}"
  python3 ./waf build

  # the shims, against this build's libjack
  local d
  for d in pw-shim pa-shim jackbus-alsa; do
    make -C nspa/$d JACK_BUILD="$PWD/build"
  done
}

package() {
  cd jack2
  python3 ./waf install --destdir="$pkgdir"

  local d
  for d in pw-shim pa-shim jackbus-alsa; do
    make -C nspa/$d JACK_BUILD="$PWD/build" DESTDIR="$pkgdir" install
  done
}

